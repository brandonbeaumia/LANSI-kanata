data:text/html;charset=utf-8,<!doctype html><body><p>Taken from github.com/argenkiwi. As you type in the textarea%2C the script will measure how long you take to press and release a key and calculate min%2C max and average times.</p><p> Make sure to disable any keyboard mapping or customisation software before proceeding. This is just an experiment and I can't guarantee its precision or utility.</p>%0A<textarea id=%22input%22></textarea><div id=%22dwell%22 />%0A<script>window.addEventListener(%22keydown%22%2C log);%0Awindow.addEventListener(%22keyup%22%2C log);%0A%0Avar keycode = null;%0Avar downtime = null;%0Avar count = 0;%0Avar min = 1000;%0Avar max = 0;%0Avar accum = 0;%0Afunction log(event) {%0A  console.log(event.type %2B %22: %22 %2B event.timeStamp);%0A  switch (event.type) {%0A    case %22keydown%22:%0A      if (keycode) break;%0A      keycode = event.keycode;%0A      downtime = event.timeStamp;%0A      break;%0A    case %22keyup%22:%0A      if (keycode == event.keycode) {%0A        keycode = null;%0A        count%2B%2B;%0A        let elapsed = event.timeStamp - downtime;%0A        min = Math.min(min%2C elapsed);%0A        max = Math.max(max%2C elapsed);%0A        accum %2B= elapsed;%0A        document.getElementById(%22dwell%22).innerHTML =%0A          %22Dwell%22 %2B%0A          %22 - Min: %22 %2B%0A          min %2B%0A          %22 %7C Max: %22 %2B%0A          max %2B%0A          %22 %7C Average: %22 %2B%0A          accum / count;%0A      }%0A      break;%0A  }%0A}%0A</script></body>
