;; see issue at https://github.com/jtroo/kanata/issues/2199 for explainer

(defcfg
  process-unmapped-keys yes
  delegate-to-first-layer yes
  concurrent-tap-hold yes
  chords-v2-min-idle 5
)

(defvirtualkeys
    ;; https://jtroo.github.io/config.html#chordsv2-processing-order
    left-paren S-9
    right-paren S-0
)

(defchordsv2
    (w e) (multi (on-press press-vkey left-paren) (on-press release-vkey left-paren)) 40 first-release (base)
    (i o) (multi (on-press press-vkey right-paren) (on-press release-vkey right-paren)) 40 first-release (base)
)

(defsrc)

(deflayermap (base-with-chords)

(deflayermap (base) ;; high hold timeout to showcase bug
    ralt
    (multi
        (layer-while-held base-with-chords)
        (tap-hold-press 0 300 ret (layer-while-held numsym))
    )
)

(deflayermap (numsym)
    a 1 s 2 d 3 f 4 g 5 h 6 j 7 k 8 l 9 ; 0
)
