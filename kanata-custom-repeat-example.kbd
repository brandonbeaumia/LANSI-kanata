(deftemplate custom-repeat (action delay interval)
  (multi 
    (macro $action) ;; wrap in macro to prevent repeating
    (tap-hold 0 $delay
        XX ;; do nothing on tap because we already did it
        (macro-repeat $action $interval) ;; begin repeating action every $interval ms after initial hold timeout
    )
  )
)

(defalias very-fast-a (t! custom-repeat a 150 5)

(deftemplate custom-repeat-double (action1 action2 delay interval) ;; triple quadruple etc
  (multi 
    (macro $action1 $action2) ;; wrap in macro to prevent repeating
    (tap-hold 0 $delay
        XX ;; do nothing on tap because we already did it
        (macro-repeat $action1 $action2 $interval) ;; begin repeating actions after initial hold timeout
    )
  )
)

(defalias hahaha (t! custom-repeat h a 150 20)

(deftemplate custom-repeat-with-vkey-toggle (action vkey delay interval) ;; also toggle vkey for use in other state checks or final stop/start action
  (multi
    (on-press press-vkey $vkey)
    (on-release release-vkey $vkey)
    (macro $action) ;; wrap in macro to prevent repeating
    (tap-hold 0 $delay
        XX ;; do nothing on tap because we already did it
        (macro-repeat $action1 $action2 $interval) ;; begin repeating action every $interval ms after initial hold timeout
    )
  )
)
